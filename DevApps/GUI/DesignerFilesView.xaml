<UserControl x:Class="DevApps.GUI.DesignerFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DevApps.GUI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="CenteredEditingStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="WrappedAndCenteredTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="WrappedAndCenteredEditingStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Pen x:Key="shapePen" Brush="{Binding AccentBrush}" Thickness="0.1" />
        <Style x:Key="CenterGridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <local:StringToEditCharConverter x:Key="editConverter"/>
        <local:BoolToCheckCharConverter x:Key="boolConverter"/>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <DataGrid x:Name="dataGrid" AllowDrop="True" Drop="DataGrid_Drop" BeginningEdit="DataGrid_BeginningEdit" CellEditEnding="DataGrid_CellEditEnding" AutoGenerateColumns="False" ItemsSource="{Binding Items}" CanUserResizeRows="False" CanUserAddRows="False" CanUserReorderColumns="False" CanUserSortColumns="True" CanUserResizeColumns="True" CanUserDeleteRows="False">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Ajouter..." Click="MenuItem_Click_CreateFileEntry"></MenuItem>
                    <MenuItem Header="Appliquer les modifications" Click="MenuItem_Click_ExecuteFileEntry"></MenuItem>
                    <Separator></Separator>
                    <MenuItem Header="Supprimer" Click="MenuItem_Click_DeleteFileEntry"></MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fichier" Binding="{Binding Filename}" Width="6*" MinWidth="100" EditingElementStyle="{StaticResource CenteredEditingStyle}" ElementStyle="{StaticResource CenteredTextStyle}" />
                <DataGridTextColumn Header="Objet" Binding="{Binding ObjectName}" Width="3*" MinWidth="100" EditingElementStyle="{StaticResource CenteredEditingStyle}" ElementStyle="{StaticResource CenteredTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
