<Window x:Class="DevApps.GUI.CommandsEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevApps.GUI"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="Editeur de commandes" Height="450" Width="800">
    <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ValidationMessage}" Background="LightGray"></TextBlock>
        <StackPanel DockPanel.Dock="Bottom" Margin="8" Orientation="Vertical" HorizontalAlignment="Right" Width="auto">
            <Button Width="100" Click="ButtonOK_Click">OK</Button>
        </StackPanel>
        <GroupBox DockPanel.Dock="Right" Header="Commandes disponibles" Width="300" Padding="6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
                <TextBlock Text="{Binding AvailableCommands}" TextWrapping="Wrap"/>
            </ScrollViewer>
        </GroupBox>
        <GroupBox Header="Commandes">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top">Label</TextBlock>
                <TextBox DockPanel.Dock="Top" Text="{Binding Label,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="12pt" Margin="0,0,0,6" ></TextBox>
                <TextBox DockPanel.Dock="Bottom" Text="{Binding Output,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>
                <TextBlock DockPanel.Dock="Bottom">Sortie</TextBlock>
                <TextBlock DockPanel.Dock="Top">Commandes</TextBlock>
                <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="Consolas" FontSize="10pt"></TextBox>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</Window>
