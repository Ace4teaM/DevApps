<Window x:Class="DevApps.GUI.CommandsEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevApps.GUI"
        mc:Ignorable="d"
        Closing="Window_Closing"
        Title="Editeur de commandes" Height="450" Width="800">
    <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ValidationMessage}" Background="LightGray"></TextBlock>
        <StackPanel DockPanel.Dock="Right" Margin="8" Orientation="Vertical" HorizontalAlignment="Right" Width="auto">
            <Button Width="100" Click="ButtonOK_Click">OK</Button>
        </StackPanel>
        <GroupBox DockPanel.Dock="Bottom" Header="Commandes disponibles" Height="200" Padding="6">
            <TextBlock Text="{Binding AvailableCommands}" TextWrapping="Wrap"/>
        </GroupBox>
        <GroupBox Header="Commandes">
            <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="Consolas" FontSize="10pt" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"></TextBox>
        </GroupBox>
    </DockPanel>
</Window>
