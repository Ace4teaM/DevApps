<Window x:Class="DevApps.GUI.DesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevApps.GUI"
        xmlns:app="clr-namespace:DevApps.Appli"
        mc:Ignorable="d"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        WindowStyle="None"
        Title="DesignerWindow" Height="509" Width="979">
    <Window.Resources>
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*" MinWidth="550"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="3*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <!-- Barre de Tire -->
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" DockPanel.Dock="Top" Background="Gray" Height="35" MouseLeftButtonDown="DockPanel_MouseLeftButtonDown"
                     Focusable="False"
                     FocusVisualStyle="{x:Null}">
            <DockPanel.Resources>
                <Style x:Key="SystemButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="5,0,5,0"></Setter>
                    <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
                    <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                    <Setter Property="Width" Value="30"></Setter>
                    <Setter Property="Height" Value="30"></Setter>
                    <Setter Property="FontSize" Value="20"></Setter>
                    <Setter Property="FontStyle" Value="Normal"></Setter>
                    <Setter Property="Focusable" Value="False"></Setter>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"></Setter>
                    <Setter Property="Padding" Value="0"></Setter>
                </Style>
                <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Margin" Value="3,0,0,0"></Setter>
                    <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
                    <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                    <Setter Property="Width" Value="100"></Setter>
                    <Setter Property="Background" Value="Transparent"></Setter>
                    <Setter Property="Cursor" Value="Hand"></Setter>
                    <Setter Property="Focusable" Value="False"></Setter>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"></Setter>
                </Style>
                <Style x:Key="TitleStyle" TargetType="TextBlock">
                    <Setter Property="Margin" Value="10,0,0,0"></Setter>
                    <Setter Property="VerticalAlignment" Value="Center"></Setter>
                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                    <Setter Property="Background" Value="Transparent"></Setter>
                    <Setter Property="FontFamily" Value="Tahoma"></Setter>
                    <Setter Property="FontSize" Value="16"></Setter>
                    <Setter Property="FontWeight" Value="DemiBold"></Setter>
                    <Setter Property="Foreground" Value="Black"></Setter>
                    <Setter Property="Focusable" Value="False"></Setter>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"></Setter>
                </Style>
                <Style x:Key="SubTitleStyle" TargetType="TextBlock">
                    <Setter Property="Margin" Value="10,0,0,6"></Setter>
                    <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                    <Setter Property="Background" Value="Transparent"></Setter>
                    <Setter Property="FontFamily" Value="Bauhaus 93"></Setter>
                    <Setter Property="FontSize" Value="12"></Setter>
                    <Setter Property="FontWeight" Value="Normal"></Setter>
                    <Setter Property="Foreground" Value="Black"></Setter>
                    <Setter Property="Focusable" Value="False"></Setter>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"></Setter>
                </Style>
            </DockPanel.Resources>
            <Button DockPanel.Dock="Left" Click="Button_Click" Background="Transparent" BorderThickness="0" Padding="0" Margin="0">
                <Image RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/DevApps;component/DevApps.ico" Margin="10,0,10,0" Width="30" Height="30"/>
            </Button>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ToggleButton Style="{StaticResource ToggleButtonStyle}" IsChecked="{Binding IsVariablesView, Mode=OneWay}" Click="Variables_MouseLeftButtonUp">Variables</ToggleButton>
                <ToggleButton Style="{StaticResource ToggleButtonStyle}" IsChecked="{Binding IsObjectsView, Mode=OneWay}" Click="Objects_MouseLeftButtonUp">Objets</ToggleButton>
                <ToggleButton Style="{StaticResource ToggleButtonStyle}" IsChecked="{Binding IsCommandsView, Mode=OneWay}" Click="Commands_MouseLeftButtonUp">Commandes</ToggleButton>
                <ToggleButton Style="{StaticResource ToggleButtonStyle}" IsChecked="{Binding IsFacetsOrDesignerView, Mode=OneWay}" Click="Facets_MouseLeftButtonUp">Facettes</ToggleButton>
            </StackPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource SystemButtonStyle}" Click="CloseButton_Click">✕</Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource SystemButtonStyle}" Click="MaximizeButton_Click">🗖</Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource SystemButtonStyle}" Click="MinimizeButton_Click">🗕</Button>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TitleStyle}" Text="{Binding AppTitle, Mode=OneWay}" ToolTip="{Binding AppPath, Mode=OneWay}">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Ouvrir le dossier contenant..." Click="MenuItem_Click"></MenuItem>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBlock Style="{StaticResource SubTitleStyle}">
                    <Run Text="- DevApps - v"></Run>
                    <Run Text="{Binding AppVersion, Mode=OneWay}"></Run>
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <!-- Facettes -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,5,0,0" >
            <DockPanel Height="26" Visibility="{Binding IsDesignerView, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock DockPanel.Dock="Left" Text="Facettes:" VerticalAlignment="Center" Margin="10,0,10,0" FontWeight="Bold"></TextBlock>
                <ListBox
                     x:Name="FacetListBox"
                    DockPanel.Dock="Left"
                     HorizontalAlignment="Center"
                     ItemsSource="{Binding FacetItems}"
                     SelectedItem="{Binding SelectedFacet, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="ListBox_SelectionChanged"
                     BorderThickness="0"
                     Focusable="False"
                     FocusVisualStyle="{x:Null}"
                     Background="Transparent"
                     Grid.ColumnSpan="2">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4,4,0,0"
                            Padding="0">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Supprimer" Click="MenuItem_Click_DeleteFacet"/>
                                                    <MenuItem Header="Renommer" Click="MenuItem_Click_RenameFacet"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="LightBlue"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="DodgerBlue"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter TargetName="Bd" Property="Background" Value="LightGray"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="Gray"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFE0F0FF"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="CornflowerBlue"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <!-- Style pour les items -->
                        <DataTemplate>
                            <Grid MinWidth="90" Cursor="Hand">
                                <TextBlock Background="Transparent" Text="{Binding Header}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" FontFamily="Verdana" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <Border DockPanel.Dock="Left"
                            Background="Gray"
                            BorderBrush="Gray"
                            BorderThickness="2"
                            CornerRadius="4,4,0,0"
                            Padding="0">
                    <TextBlock Margin="10,0,10,0" VerticalAlignment="Center" MouseLeftButtonUp="Add_MouseLeftButtonUp" Cursor="Hand">➕</TextBlock>
                </Border>
                <Button DockPanel.Dock="Right" x:Name="DropdownButton" Margin="0,0,10,0" Content="▼" Click="DropdownBtn_Click" />
                <Popup x:Name="DropdownPopup" PlacementTarget="{Binding ElementName=DropdownButton}" Placement="Bottom">
                    <Border BorderBrush="Gray" BorderThickness="1">
                        <StackPanel>
                            <Button Tag="Contenu" Content="Contenu" Click="PrintSize_Click" />
                            <Separator></Separator>
                            <Button Tag="Portrait" Content="Portrait" Click="PrintSize_Click" />
                            <Button Tag="Paysage" Content="Paysage" Click="PrintSize_Click" />
                        </StackPanel>
                    </Border>
                </Popup>
                <ToggleButton DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" Checked="ToggleButton_Checked" Unchecked="ToggleButton_Unchecked" IsChecked="{Binding TogglePrintZone}" Cursor="Hand" ToolTip="Afficher la zone d'impression">👁</ToggleButton>
                <Label></Label>
            </DockPanel>
        </Grid>
        <!-- Paneau droite -->
        <Grid Grid.Row="2" Grid.Column="2">
            <TabControl TabStripPlacement="Right">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Width" Value="30"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="border" Background="Transparent" Padding="0,8,0,8">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    
                                    <ControlTemplate.Triggers>
                                        <!-- Onglet sélectionné -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="LightBlue"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="SteelBlue"/>
                                        </Trigger>

                                        <!-- Onglet non sélectionné -->
                                        <Trigger Property="IsSelected" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="Transparent"/>
                                        </Trigger>

                                        <!-- Survol -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="LightGray"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem>
                    <TabItem.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="📁" TextAlignment="Center"/>
                        </DataTemplate>
                    </TabItem.HeaderTemplate>
                    <Grid HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                        <Border Margin="6">
                            <local:FilesExplorerControl 
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>
                            </Border>
                    </Grid>
                </TabItem>
                <TabItem>
                    <TabItem.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="☰" TextAlignment="Center"/>
                        </DataTemplate>
                    </TabItem.HeaderTemplate>
                    <DockPanel Margin="6">
                        <TextBlock DockPanel.Dock="Top">
                    <Run FontWeight="Bold" Text="Importer un objet:"></Run>
                    <Run Text="(glisser/déposer)"></Run>
                        </TextBlock>
                        <Separator DockPanel.Dock="Top"></Separator>
                        <ListBox
                    x:Name="ObjectListBox"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding ObjectModels}"
                    SelectedItem="{Binding SelectedObjectModel, Mode=TwoWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="ListBox_SelectionChanged"
                    BorderThickness="0"
                    Focusable="False"
                    FocusVisualStyle="{x:Null}"
                    Background="Transparent"
                    MouseMove="Grid_MouseMove">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        Padding="0">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Ouvrir le projet parent" Click="MenuItem_Click_OpenParentProject"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="LightBlue"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="DodgerBlue"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="False">
                                                        <Setter TargetName="Bd" Property="Background" Value="LightGray"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="Gray"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFE0F0FF"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="CornflowerBlue"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <!-- Style pour les items -->
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Dirname}">
                                        <TextBlock Background="Transparent" Text="{Binding Header}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" FontFamily="Verdana" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
        <!-- Splitter (colonne Auto) -->
        <GridSplitter Grid.Row="2" Grid.Column="1"
                  Width="5"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch"
                  Background="LightGray"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="True"
                  Panel.ZIndex="10"/>
        <!-- Barre d'état -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Background="LightGray">
            <DockPanel>
                <TextBlock Cursor="Hand" Width="20" TextAlignment="Center" DockPanel.Dock="Right" Background="LightSlateGray" MouseLeftButtonUp="Settings_MouseLeftButtonUp" ToolTip="Préférences">⚙️</TextBlock>
                <TextBlock Cursor="Hand" Width="20" TextAlignment="Center" DockPanel.Dock="Right" Background="LightSlateGray" MouseLeftButtonUp="Menu_MouseLeftButtonUp" ToolTip="Importer">🡅</TextBlock>
                <TextBlock Cursor="Hand" Width="20" TextAlignment="Center" DockPanel.Dock="Right" Background="LightSlateGray" MouseLeftButtonUp="Build_MouseLeftButtonUp" ToolTip="Construire">⩸</TextBlock>
                <TextBlock Cursor="Hand" Width="20" TextAlignment="Center" DockPanel.Dock="Right" Background="LightSlateGray" MouseLeftButtonUp="IA_MouseLeftButtonUp" ToolTip="Agent IA">!</TextBlock>
                <TextBlock Cursor="Hand" Width="20" TextAlignment="Center" DockPanel.Dock="Right" Background="LightSlateGray" MouseLeftButtonUp="Simulation_MouseLeftButtonUp" ToolTip="{Binding StartStopText}" Text="{Binding StartStopIcon}"></TextBlock>
                <Popup Name="ChatPopup"
                       Placement="MousePoint"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       PopupAnimation="Fade">
                    <Popup.Resources>
                        <DropShadowEffect x:Key="DropShadowEffect"
                          Color="Black"
                          Direction="270"
                          ShadowDepth="5"
                          BlurRadius="10"
                          Opacity="0.3"/>
                        <Style TargetType="TextBox" x:Key="RoundedTextBox">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#88BBDD"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Popup.Resources>
                    <Grid>
                        <Border Background="#D0E8FF" CornerRadius="15" Padding="15" Width="300" Effect="{DynamicResource DropShadowEffect}" BorderBrush="#88BBDD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Saisissez votre demande :" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBox Name="PopupInput" Style="{StaticResource RoundedTextBox}" Height="80" Margin="0,0,0,10" Background="White"/>
                                <DockPanel>
                                    <ComboBox Name="IACombo" DockPanel.Dock="Left" SelectedValuePath="Tag" Width="160">
                                        <ComboBoxItem Tag="GPT">ChatGPT</ComboBoxItem>
                                        <ComboBoxItem Tag="MISTRAL" IsSelected="True">Mistral</ComboBoxItem>
                                    </ComboBox>
                                    <Button DockPanel.Dock="Right" Content="{Binding SendButtonText}" Width="80" HorizontalAlignment="Right" Click="IASendPopup_Click" IsDefault="True"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>
                <TextBlock Foreground="Black" Text="{Binding StatusText}" Margin="6,0,0,0"></TextBlock>
            </DockPanel>
        </Border>
        <!-- Vue -->
        <ContentControl Grid.Row="2" Grid.Column="0" x:Name="content">
            <local:WelcomeView></local:WelcomeView>
        </ContentControl>
    </Grid>
</Window>
