<Window x:Class="DevApps.GUI.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DevApps.GUI"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" MinWidth="150"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="3*" MinWidth="150"/>
        </Grid.ColumnDefinitions>
        <!-- Barre de Tire -->
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" DockPanel.Dock="Top" Background="DarkCyan" Height="35" >
        </DockPanel>
        <!-- Facettes -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,5,0,0" Background="Beige" >
        </Grid>
        <!-- Paneau droite -->
        <Grid Grid.Row="2" Grid.Column="2"  Background="AliceBlue">
        </Grid>

        <!-- Splitter (colonne Auto) -->
        <GridSplitter Grid.Row="2" Grid.Column="1"
                  Width="5"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch"
                  Background="LightGray"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  ShowsPreview="True"
                  Panel.ZIndex="10"/>
        <!-- Barre d'état -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Background="LightGray">
           
        </Border>
        <!-- Vue -->
        <ContentControl Grid.Row="2" Grid.Column="0" x:Name="content" Background="Aquamarine">
            
        </ContentControl>
    </Grid>
</Window>
